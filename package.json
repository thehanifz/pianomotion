{
  "name": "pianomotion",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid Python + Remotion project for transcribing piano audio into MIDI/JSON note events and rendering pressed-note dot visualizations.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "app:dev": "concurrently -n API,WEB -c cyan,magenta \"tsx server/index.ts\" \"vite\"",
    "app:build": "vite build",
    "app:start": "tsx server/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs pianomotion"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "@remotion/player": "^4.0.547",
    "@remotion/renderer": "^4.0.547",
    "@tonejs/midi": "^2.0.28",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
