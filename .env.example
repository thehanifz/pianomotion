# Port & bind host untuk PianoMotion Web UI & API
PORT=4000
HOST=0.0.0.0

# Opsional: override path Python (default otomatis ke venv/Scripts/python.exe atau venv/bin/python)
# PYTHON_BIN=venv/bin/python

# Opsional: biarkan kosong/komentar agar auto-detect jumlah core mesin atau kuota LXC.
# Contoh untuk LXC 3 core agar tetap ringan (atau biarkan kosong untuk auto-detect):
# REMOTION_CONCURRENCY=2
# TORCH_NUM_THREADS=2

# Opsional: paksa --no-sandbox pada Chromium (otomatis aktif jika berjalan sebagai root di Linux/LXC)
# CHROMIUM_NO_SANDBOX=1
